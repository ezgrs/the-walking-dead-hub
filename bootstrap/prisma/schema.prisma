generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Episode {
  id            Int          @id @default(autoincrement())
  name          String       @db.VarChar(127)
  wikiHref      String       @unique(map: "uq_episodes_wikihref") @map("wikihref") @db.VarChar(127)
  seasonNumber  Int          @map("season") @db.SmallInt
  episodeNumber Int          @map("number") @db.SmallInt
  appearances   Appearance[]

  @@map("episodes")
}

model Entity {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(127)
  wikiHref    String       @unique(map: "uq_entities_wikihref") @map("wikihref") @db.VarChar(127)
  appearances Appearance[]

  @@map("entities")
}

model Appearance {
  id               Int              @id @default(autoincrement())
  episodeId        Int              @map("episodeid")
  entityId         Int              @map("entityid")
  appearanceTypeId Int              @map("appearancetypeid")
  appearanceForms  AppearanceForm[]
  appearanceType   AppearanceType   @relation(fields: [appearanceTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entity           Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  episode          Episode          @relation(fields: [episodeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([episodeId, entityId], map: "uq_appearances_episodeid_entityid")
  @@map("appearances")
}

model AppearanceType {
  id          Int                   @id @default(autoincrement())
  name        String                @db.VarChar(127)
  appearances Appearance[]
  aliases     AppearanceTypeAlias[]

  @@map("appearancetypes")
}

model AppearanceTypeAlias {
  id             Int            @id @default(autoincrement())
  referenceId    Int            @map("refid")
  label          String         @db.VarChar(127)
  appearanceType AppearanceType @relation(fields: [referenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("appearancetypealiases")
}

model AppearanceFormType {
  id              Int                       @id @default(autoincrement())
  name            String                    @db.VarChar(127)
  appearanceforms AppearanceForm[]
  aliases         AppearanceFormTypeAlias[]

  @@map("appearanceformtypes")
}

model AppearanceFormTypeAlias {
  id                 Int                @id @default(autoincrement())
  referenceId        Int                @map("refid")
  label              String             @db.VarChar(127)
  appearanceFormType AppearanceFormType @relation(fields: [referenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("appearanceformtypealiases")
}

model AppearanceForm {
  id                   Int                @id @default(autoincrement())
  appearanceId         Int                @map("appearanceid")
  appearanceFormTypeId Int                @map("appearanceformtypeid")
  appearanceformtypes  AppearanceFormType @relation(fields: [appearanceFormTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appearance           Appearance         @relation(fields: [appearanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([appearanceId, appearanceFormTypeId], map: "uq_appearanceforms_appearanceid_appearanceformtypeid")
  @@index([appearanceId], map: "ix_appearanceforms_appearanceid")
  @@map("appearanceforms")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model BootstrapRun {
  version    Int    @id
  executedAt DateTime @default(now())

  @@map("bootstrapruns")
}